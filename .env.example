# Copy to .env (export the variables, or use `node --env-file=.env src/start.js` on Node 20+)
JWT_SECRET=change-me
INTERNAL_SERVICE_TOKEN=change-me-too
GATEWAY_API_KEYS=demo-key-123,mobile-app-key-456
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
DB_FILE=./fleet.db
# Geocoding: osm | google | mock
GEOCODER=osm
GOOGLE_MAPS_API_KEY=
# SMS: mock | twilio
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
